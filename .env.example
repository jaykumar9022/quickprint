# QuickPrint SaaS Environment Configuration Reference
# ====================================================

# Port and Applet URL
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME"
PGHOST="localhost"
PGPORT=5432
PGUSER="quickprint_user"
PGPASSWORD="REPLACE_WITH_DB_PASSWORD"
PGDATABASE="quickprint"
PGSSL="false"

# Admin Authentication
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="REPLACE_WITH_ADMIN_PASSWORD"
ADMIN_JWT_SECRET="REPLACE_WITH_RANDOM_JWT_SECRET"

# Payment Gateway (Razorpay Sandbox / Test Mode)
RAZORPAY_KEY_ID="REPLACE_WITH_RAZORPAY_TEST_KEY_ID"
RAZORPAY_KEY_SECRET="REPLACE_WITH_RAZORPAY_TEST_KEY_SECRET"
WEBHOOK_SECRET="REPLACE_WITH_RANDOM_WEBHOOK_SECRET"

# Print Agent Station Credentials
AGENT_REGISTRATION_KEY="REPLACE_WITH_RANDOM_AGENT_KEY"

# Document Retention Policy
DOCUMENT_RETENTION_HOURS=2
MAX_FILE_SIZE_MB=25
MAX_PAGES_ALLOWED=250

# Shop Profile Defaults
SHOP_ID="shop_001"
SHOP_NAME="QuickPrint Xerox & Digital Hub"
SHOP_TAGLINE="High Speed Laser & Color Printing Station"
SHOP_ADDRESS="YOUR_SHOP_ADDRESS"
SHOP_PHONE="YOUR_SHOP_PHONE"
SHOP_EMAIL="YOUR_SHOP_EMAIL"
SHOP_UPI_VPA="YOUR_SHOP_UPI_VPA"
SHOP_CURRENCY="INR"
SHOP_MIN_ORDER_PAISE=500
SHOP_WIFI_SSID="YOUR_SHOP_WIFI_SSID"
SHOP_WIFI_PASSWORD="REPLACE_WITH_WIFI_PASSWORD"
